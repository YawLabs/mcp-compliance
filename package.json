{
  "name": "@yawlabs/mcp-compliance",
  "version": "0.18.0",
  "mcpName": "io.github.YawLabs/mcp-compliance",
  "description": "MCP compliance testing: spec suites for MCP 2025-11-25 (88 tests) and 2026-07-28 (103 tests), auto-detected per server, for any MCP server over HTTP or stdio, with A-F grading, a CLI, an MCP server, and CI output.",
  "license": "MIT",
  "author": "Yaw Labs <contact@yaw.sh> (https://yaw.sh)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/runner.js",
      "types": "./dist/runner.d.ts"
    },
    "./mcp/server": {
      "import": "./dist/mcp/server.js",
      "types": "./dist/mcp/server.d.ts"
    },
    "./schemas/*.json": "./schemas/*.json"
  },
  "main": "./dist/runner.js",
  "types": "./dist/runner.d.ts",
  "bin": {
    "mcp-compliance": "bin/mcp-compliance.mjs"
  },
  "files": [
    "dist",
    "bin/mcp-compliance.mjs",
    "!dist/**/*.test.*",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "node scripts/lint.mjs check src/",
    "lint:fix": "node scripts/lint.mjs check --write src/",
    "typecheck": "tsc --noEmit",
    "test:ci": "npm run build && npm test",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.3",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/node": "^25.5.2",
    "esbuild": "^0.28.1",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-testing",
    "compliance",
    "testing",
    "test-suite",
    "spec",
    "validation",
    "json-rpc",
    "cli",
    "ci",
    "github-actions",
    "sarif",
    "security",
    "stdio",
    "claude-code",
    "cursor",
    "ai",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YawLabs/mcp-compliance.git"
  },
  "bugs": {
    "url": "https://github.com/YawLabs/mcp-compliance/issues"
  },
  "homepage": "https://yaw.sh/mcp-servers/mcp-compliance/"
}
